:host {
  display: block;
  height: 40px;
  background-color: #fff;
}

.nsi-audio-player {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  border: 1px solid rgba(0, 0, 0, 0.24);
  line-height: 1;
  box-sizing: border-box;

  &.round {
    border-radius: 24px;
    overflow: hidden;

    .button {
      border-radius: 50%;
    }
  }
}

audio {
  display: none;
}

svg {
  width: 24px;
  height: 24px;
}

/* play & pause */

.button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  border: 2px solid transparent;
  padding: 0;
  cursor: pointer;
  outline: none;
  box-sizing: border-box;

  &:focus {
    border: 2px solid hsla(200, 50%, 50%, 0.24);
  }

  &:active svg {
    fill: rgba(0, 0, 0, 0.4);
  }

  &.pp-button {
    position: absolute;
    left: 0;
    width: 40px;
    height: 40px;
  }
}

/* audio info */
.audio-info {
  position: absolute;
  display: inline-flex;
}

.audio-title {
  color: rgba(0, 0, 0, 0.72);
}

.remaining-time {
  position: absolute;
  right: 56px;
  bottom: 2px;
  color: rgba(0, 0, 0, 0.72);
  font-size: 14px;
}

.progress-bar {
  position: absolute;
  right: 40px;
  left: 40px;
  height: 100%;
}

.progress-inner {
  position: absolute;
  left: 0;
  width: 0;
  height: 100%;
  background: rgba(0, 0, 0, 0.24);
  transition: width 0.1s cubic-bezier(0.22, 0.61, 0.36, 1);
}

/* controls */
.controls-container {
  position: absolute;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #fff;
}

.controls {
  position: absolute;
  right: 0;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  transform: translate3d(100%, 0, 0);
  padding-right: 40px;
  background-color: inherit;
  transition: transform 0.2s cubic-bezier(0.32, 0, 0.67, 0);

  &.open {
    display: inline-flex;
    transform: translate3d(0, 0, 0);
    transition: transform 0.2s cubic-bezier(0.33, 1, 0.68, 1);
  }
}

.more-button {
  position: relative;
  width: 40px;
  height: 40px;
  z-index: 1;
  background-color: inherit;
}

.repeat-button {
  svg {
    fill: rgba(0, 0, 0, 0.32);
    transition: fill 0.08s ease;
  }

  &.on svg {
    fill: rgba(0, 0, 0, 1);
  }
}

/* Volume */
.volume-display {
  display: inline-flex;
  justify-content: center;
  align-items: center;
}

.volume-button {
  box-sizing: border-box;
  padding: 8px;
  width: 40px;
  height: 40px;
  cursor: pointer;
}

.volume-slider {
  -webkit-appearance: none;
  appearance: none;
  background-color: rgba(0, 0, 0, 0.72);
  height: 4px;
  width: 100px;
  border-radius: 2px;

  &::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    position: relative;
    border: 2px solid rgba(0, 0, 0, 0.72);
    width: 20px;
    height: 20px;
    display: block;
    background-color: #fff;
    border-radius: 50%;
  }

  &:active::-webkit-slider-thumb {
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.4);
    transition: 0.2s;
  }
}
